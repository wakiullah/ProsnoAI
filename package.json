{
  "name": "proshno-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "shared",
    "server",
    "client"
  ],
  "scripts": {
    "dev:server": "yarn workspace proshno-server dev",
    "dev:client": "yarn workspace proshno-client dev",
    "start:client": "yarn workspace proshno-client start",
